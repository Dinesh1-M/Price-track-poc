
# Non-production local Windows POC; no Docker required.
PORT=3000
DB_PROVIDER=sqlite
SQLITE_PATH=./data/price-track.sqlite
LOCAL_ACCESS_DIR=./data/local-access
# Optional source-workbook paths (defaults are the supplied files in data/).
# SALESFORCE_WORKBOOK_PATH=D:/Price_Tracker/sources/Salesforce sythetic data.xlsx
# MARGIN_WORKBOOK_PATH=D:/Price_Tracker/sources/Margin Calculator_new 1.xlsx
# Optional import source. First SQLite startup imports this file without modifying it.
# DATA_FILE=./data/store.json
# Explicit legacy tests only: DB_PROVIDER=json
# Production startup is deliberately disabled pending enterprise security/Finance verification.
